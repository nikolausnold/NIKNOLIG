<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/active_green" />
        </shape>
    </item>
    <item android:inset="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/dark_surface" />
            <stroke
                android:width="2dp"
                android:color="@color/gold" />
        </shape>
    </item>
    <item android:inset="8dp">
        <shape android:shape="oval">
            <gradient
                android:angle="45"
                android:endColor="@color/gold"
                android:startColor="#FFF0B5" />
        </shape>
    </item>
</layer-list>
