<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/elektro_engel_scroll_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/screen_padding">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@null"
                android:src="@drawable/niknolig_mark" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_small"
                android:accessibilityHeading="true"
                android:letterSpacing="0.12"
                android:text="@string/brand_name"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:orientation="horizontal">

            <Button
                android:id="@+id/niknolig_nav_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/niknolig_nav_label" />

            <Button
                android:id="@+id/elektro_engel_nav_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_small"
                android:layout_weight="1"
                android:text="@string/elektro_engel_nav_label" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:accessibilityHeading="true"
            android:text="@string/elektro_engel_title"
            android:textColor="@color/gold"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_small"
            android:text="@string/elektro_engel_description"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:background="@color/dark_surface"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/preview_examples_heading"
                android:textColor="@color/gold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/preview_examples_instructions"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/scenario_button_container"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:orientation="vertical" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:background="@color/dark_surface"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/preview_status_label"
                android:textColor="@color/brand_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scenario_preview_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:accessibilityHeading="true"
                android:textColor="@color/text_primary"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/scenario_preview_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:accessibilityLiveRegion="polite"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_large"
            android:background="@color/dark_surface"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:accessibilityHeading="true"
                android:text="@string/local_assistant_heading"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/local_assistant_description"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/assistant_question"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:hint="@string/local_assistant_question_hint"
                android:importantForAutofill="no"
                android:inputType="textCapSentences|textMultiLine|textNoSuggestions"
                android:maxLength="500"
                android:maxLines="3" />

            <Button
                android:id="@+id/assistant_ask_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/local_assistant_ask_button" />

            <TextView
                android:id="@+id/assistant_answer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:accessibilityLiveRegion="polite"
                android:text="@string/local_assistant_initial_answer"
                android:textColor="@color/text_primary"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_medium"
                android:accessibilityHeading="true"
                android:text="@string/interest_profile_heading"
                android:textColor="@color/gold"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/interest_profile_description"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/interest_consent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interest_profile_consent" />

            <CheckBox
                android:id="@+id/interest_work"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_work_button" />

            <CheckBox
                android:id="@+id/interest_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_devices_button" />

            <CheckBox
                android:id="@+id/interest_transport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_transport_button" />

            <CheckBox
                android:id="@+id/interest_everyday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/preview_everyday_button" />

            <TextView
                android:id="@+id/interest_profile_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:text="@string/interest_profile_disabled_status"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/interest_profile_save_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_small"
                android:text="@string/interest_profile_save_button" />

            <Button
                android:id="@+id/interest_profile_clear_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/interest_profile_clear_button" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_medium"
            android:background="@color/dark_surface"
            android:padding="@dimen/card_padding"
            android:text="@string/elektro_engel_preview_notice"
            android:textColor="@color/text_primary"
            android:textSize="14sp" />
    </LinearLayout>
</ScrollView>
